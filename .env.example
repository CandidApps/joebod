# Google Health / Fitbit (JOEbod)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3001/api/google-health/callback
JOEBOD_TOKEN_SECRET=replace-with-long-random-string-at-least-32-chars

# Claude Coach (server-only — never expose to the browser)
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=
